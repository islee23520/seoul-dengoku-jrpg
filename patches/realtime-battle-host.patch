diff --git a/engine/src/player/runtimeSimulationPort.ts b/engine/src/player/runtimeSimulationPort.ts
new file mode 100644
--- /dev/null
+++ b/engine/src/player/runtimeSimulationPort.ts
@@ -0,0 +1,20 @@
+import type { PlaySceneContext } from './playSceneTypes';
+
+export type SimulationBinding = {
+  readonly elapsed: (milliseconds: number) => void;
+  readonly completedStep: (step: { readonly mapId: string; readonly x: number; readonly y: number }) => unknown;
+  readonly present: (scene: PlaySceneContext, milliseconds: number) => void;
+  readonly release: () => void;
+};
+export type RuntimeSimulationPort = { readonly bind: (scene: PlaySceneContext) => SimulationBinding };
+const ports = new WeakMap<object, RuntimeSimulationPort>();
+const bindings = new WeakMap<object, SimulationBinding>();
+export function installSimulationPort(game: object, port: RuntimeSimulationPort): void { ports.set(game, port); }
+export function bindSimulation(scene: PlaySceneContext): (() => void) | undefined {
+  const port = ports.get(scene.game);
+  if (!port) return undefined;
+  const binding = port.bind(scene);
+  bindings.set(scene, binding);
+  return () => { binding.release(); if (bindings.get(scene) === binding) bindings.delete(scene); };
+}
+export function simulationBinding(scene: PlaySceneContext): SimulationBinding | undefined { return bindings.get(scene); }
